# ==============================================================================
# MedOcupa ERP - Configuración de Variables de Entorno (Producción / Pruebas)
# ==============================================================================

# Entorno de Ejecución ('development', 'production', 'test')
NODE_ENV="production"
PORT=3000

# URL de la Aplicación en Cloud Run / Servidor HTTPS
APP_URL="https://medocupa-erp.empresa.pe"

# Secretos de Autenticación
# IMPORTANTE: Cambia este secreto en producción por una cadena aleatoria de al menos 32 caracteres.
JWT_SECRET="CAMBIAR_EN_PRODUCCION_MEDOCUPA_JWT_SECRET_SECURE_KEY_2026"
JWT_EXPIRES_IN="24h"

# Conexión a Base de Datos PostgreSQL Producción
# Formato: postgresql://usuario:password@host:5432/nombre_bd?schema=public
DATABASE_URL="postgresql://medocupa_user:MedOcupaPass2026!@postgres-db:5432/medocupa_prod?schema=public"

# Conexión a Base de Datos para Entorno de Pruebas / QA (Aislamiento de Pruebas)
DATABASE_URL_TEST="postgresql://medocupa_user:MedOcupaPass2026!@postgres-db:5432/medocupa_test?schema=public"

# Google Gemini API Key (Opcional - asistencias médicas IA)
GEMINI_API_KEY=""

# Configuración de Respaldos (pg_dump)
BACKUP_DIR="/var/backups/medocupa"
GCS_BACKUP_BUCKET="medocupa-backups-rsa-bucket"
S3_BACKUP_BUCKET=""

# Configuración SMTP Notificaciones de Salud y Alertas SAT (Notificación Accidente 24h)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notificaciones@medocupa.pe"
SMTP_PASS="password_aplicacion_smtp"
